<div class="min-h-screen flex items-center justify-center bg-base-200/30 px-4">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <a href="/" class="inline-flex items-center gap-3 group">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-content font-bold text-lg shadow-sm">
          X
        </div>
        <span class="text-xl font-bold tracking-tight text-base-content">XWA</span>
      </a>
      <p class="mt-3 text-sm text-base-content/50">Sign in to continue</p>
    </div>

    <div class="rounded-2xl border border-base-200 bg-base-100 p-8 shadow-sm">
      <form method="post" action={~p"/login"} class="space-y-5">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

        <div>
          <label class="block text-sm font-medium text-base-content/70 mb-1.5">Username</label>
          <input
            type="text"
            name="username"
            autocomplete="username"
            autofocus
            required
            class="w-full rounded-lg border border-base-300 bg-base-200/50 px-3 py-2 text-sm text-base-content placeholder:text-base-content/30 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-base-content/70 mb-1.5">Password</label>
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            required
            class="w-full rounded-lg border border-base-300 bg-base-200/50 px-3 py-2 text-sm text-base-content focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-content hover:brightness-110 transition-all"
        >
          Sign in
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-base-content/50">
        No account? <a href={~p"/register"} class="text-primary hover:underline">Create one</a>
      </p>

      <div class="mt-4 pt-4 border-t border-base-200 space-y-2">
        <p class="text-xs text-center text-base-content/40 mb-3">Or sign in with</p>
        <a
          href={~p"/auth/google"}
          class="flex w-full items-center justify-center gap-2 rounded-lg border border-base-300 px-4 py-2 text-sm font-medium text-base-content/70 hover:bg-base-200 transition-colors"
        >
          Google
        </a>
        <a
          href={~p"/auth/github"}
          class="flex w-full items-center justify-center gap-2 rounded-lg border border-base-300 px-4 py-2 text-sm font-medium text-base-content/70 hover:bg-base-200 transition-colors"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</div>
